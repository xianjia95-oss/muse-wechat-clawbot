[Unit]
Description=Muse Link conversation owner watchdog
After=muse-link.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
Environment=NODE_ENV=production
EnvironmentFile=-__HOME__/.config/muse-link/env
WorkingDirectory=__HOME__/.local/share/muse-link/current
ExecStart=__NODE__ __HOME__/.local/share/muse-link/current/scripts/owner-watchdog.mjs run --config __HOME__/.config/muse-link/owner-watchdog.json
Restart=always
RestartSec=5
TimeoutStopSec=75
KillMode=control-group
MemoryMax=192M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
